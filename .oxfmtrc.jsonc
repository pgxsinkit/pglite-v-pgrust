{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "trailingComma": "all",
  "bracketSpacing": true,
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "useTabs": false,
  "insertFinalNewline": true,
  "sortImports": {
    "newlinesBetween": true,
  },
  "sortPackageJson": {
    "sortScripts": true,
  },
  // Byte-verbatim pgrust sources (see src/vendor/pgrust/SOURCE.md) must stay identical to upstream.
  "ignorePatterns": ["src/vendor/**"],
}
